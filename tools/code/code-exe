#!/bin/sh
set -eu

CODE_BIN="$(command -v code-bin)"
REAL_HOME="${HOME:?HOME is not set}"
ROOT="${XDG_DATA_HOME:-$REAL_HOME/.local/share}/nux-vscode"

mkdir -p "$ROOT/user-data" "$ROOT/extensions"

exec env -i \
    HOME="$REAL_HOME" \
    USER="${USER:-$(id -un)}" \
    PATH="/usr/bin:/bin:$REAL_HOME/.local/bin" \
    LANG="${LANG:-C.UTF-8}" \
    DISPLAY="${DISPLAY:-}" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
    XAUTHORITY="${XAUTHORITY:-}" \
    "$CODE_BIN" \
    --user-data-dir "$ROOT/user-data" \
    --extensions-dir "$ROOT/extensions" \
    "$@"
