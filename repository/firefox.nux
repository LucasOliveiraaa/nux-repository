program firefox {
    let version = "159.0";
    version("${version}");

    source(url = "https://ftp.mozilla.org/pub/firefox/releases/${version}/linux-x86_64/en-US/firefox-${version}.tar.xz");

    bash {
        mkdir -p $NUX_PREFIX
        tar -xJf $NUX_SOURCE_PATH -C $NUX_PREFIX --strip-components=1
    }

    set_bin("firefox");
}