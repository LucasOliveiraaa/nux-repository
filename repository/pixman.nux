
program pixman {
    let release = "0.44.2";
    version(release);

    source(url = "https://www.cairographics.org/releases/pixman-${release}.tar.gz");

    bash {
        tar -xzf $NUX_SOURCE_PATH --strip-components=1
        meson setup build --prefix=$NUX_PREFIX --libdir=lib --buildtype=release -Dtests=disabled
        ninja -C build
        ninja -C build install
    }

    export_lib("pixman-1");
}
